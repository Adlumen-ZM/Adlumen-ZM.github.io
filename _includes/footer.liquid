{% capture footer_contents %}
  &copy; Copyright {{ site.time | date: '%Y' }}
  {{ site.first_name }}
  {{ site.middle_name }}
  {{ site.last_name }}. {{ site.footer_text }}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    Last updated: {{ 'now' | date: '%B %d, %Y' }}.
  {% endif %}
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container">
      {{ footer_contents }}
    </div>
  </footer>
{% endif %}

<style>
  /* 页脚样式 */
  footer {
    background-color: var(--bg-secondary);
    border-top: var(--border-default);
    padding: 2rem 0;
    margin-top: 4rem;
  }
  
  footer .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 calc(var(--space-unit) * 3);
  }
  
  footer p {
    font-family: var(--font-body);
    font-size: 0.88rem;
    color: var(--text-secondary);
    text-align: center;
    margin-bottom: 0;
  }
  
  footer a {
    color: var(--color-accent);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  
  footer a:hover {
    color: var(--color-accent-hover);
    text-decoration: underline;
  }
  
  /* 响应式调整 */
  @media (max-width: 768px) {
    footer {
      padding: 1.5rem 0;
      margin-top: 3rem;
    }
    
    footer .container {
      padding: 0 calc(var(--space-unit) * 2);
    }
  }
</style>